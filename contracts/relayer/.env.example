# Keeper account. Needs ETH on Robinhood Chain for gas and must be registered
# with setReporter() on HedgeOracle.
#
# Use a dedicated throwaway key — NEVER the admin/deployer key.
#
# This key sits on an always-on server and signs every few seconds, so it is the
# most exposed part of the system. Admin can set any price past the deviation
# guard, drain the junior tranche, rewrite every risk rule and transfer the role
# away. Keeping them separate means a leaked keeper key is revoked with a single
# setReporter(key, false); if they are the same key there is nothing to revoke
# with. Generate one with: cast wallet new
RELAYER_PRIVATE_KEY=0x

ORACLE_ADDRESS=0x
ENGINE_ADDRESS=0x

# Stock desk. Optional. When set, each tick pulls Blockscout exchange_rate for
# the top five and writes markUsd6. The keeper must be marksReporter on the
# desk — deploy script does that from KEEPER. Do not make the keeper admin.
STOCK_COLLATERAL=0x
# BLOCKSCOUT_API=https://robinhoodchain.blockscout.com/api/v2

# Optional overrides.
# Official RPC is Cloudflare-fronted. Datacenter hosts (Railway, Fly, Render)
# often get a JS challenge (HTTP 403 HTML) instead of JSON-RPC. Comma-separate
# a fallback — the keeper tries each in order.
# RH_RPC=https://rpc.mainnet.chain.robinhood.com,https://rpc-robinhood.blockmachine.io
RH_RPC=https://rpc-robinhood.blockmachine.io
CLOB_BASE=https://clob.polymarket.com
TICK_MS=15000

# --- monitoring -------------------------------------------------------------
# Set at least one of these. Without them the keeper can die at 3am and the
# only record is a log file nobody is reading.

# Slack or Discord incoming webhook.
ALERT_WEBHOOK_URL=

# Telegram, if you prefer it. Both are sent when both are configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Distinguishes instances in alerts when you run more than one keeper.
KEEPER_LABEL=hedge-keeper

# Repeat suppression for the same alert, in ms. Default 15 minutes.
ALERT_COOLDOWN_MS=900000

# /health starts returning 503 once the last clean tick is older than this.
# Keep it under the oracle's maxPriceAge (5m) so you hear about it before
# trading halts itself.
HEALTH_STALE_AFTER_MS=240000
HEALTH_PORT=8080

# Alert when the keeper's gas drops below this. A keeper out of gas fails
# exactly like a dead one.
MIN_BALANCE_ETH=0.01

# Consecutive failed ticks before the keeper pulls the guardian brake and halts
# new positions. Requires setGuardian(keeper) to have been called by admin.
FAILURES_BEFORE_PAUSE=4

# Local dry runs only. If this is set in production the keeper relays invented
# prices instead of Polymarket's.
# MOCK_PRICES=
