# Copy to .env — Foundry loads it automatically for forge script and cast.
# .env is gitignored. Nothing here is a secret; the deployer key is deliberately
# not one of these variables (see below).

# The account that ends up holding the admin role. Must be the same address that
# signs the deploy, because Deploy.s.sol calls vault.setEngine() in the same run.
# Needs ETH on Robinhood Chain for gas.
ADMIN=0xd78610499138b019d15DBD0246e1B0A10778390D

RPC=https://rpc.mainnet.chain.robinhood.com

# Filled in from the addresses Deploy.s.sol prints under "== Return ==".
# Configure.s.sol reads ORACLE and ENGINE; KEEPER is the relayer account that
# gets setReporter() and the guardian role.
ORACLE=0x
VAULT=0x
ENGINE=0x
STOCK_COLLATERAL=0x
KEEPER=0x

# There is no PRIVATE_KEY here on purpose.
#
# The deployer holds admin, which can set any price past the deviation guard,
# drain the junior tranche, rewrite every risk rule and transfer the role away.
# A key in a dotfile leaks through backups, editor plugins and shell history, and
# unlike the keeper key there is nothing to revoke it with. Keep it in Foundry's
# encrypted keystore instead:
#
#   cast wallet new ~/.foundry/keystores hedge-admin   # prints only the address
#   forge script script/Deploy.s.sol:Deploy \
#     --rpc-url $RPC --account hedge-admin --sender $ADMIN --broadcast
#
# USDG is not here either: it defaults to the real token on chain 4663 and
# setting it to anything else there reverts. Pass it inline for a local anvil.
