# Client (safe to expose)
VITE_PRIVY_APP_ID=

# Master switch for leveraged trading (the 2x/3x selector).
#
# Anything but "true" leaves spot as the only path. Earn is independent: if
# VITE_HEDGE_VAULT_ADDRESS is set, deposits work even while this is false, so
# the pool can be seeded before the first levered ticket is offered.
VITE_LEVERAGE_ENABLED=true

# Hedge contracts on Robinhood Chain, printed by contracts/script/Deploy.s.sol.
#
# The server reads these same names to decide which contracts it will pay gas
# for, so a mismatch shows up as sponsored calls being refused.
VITE_HEDGE_ENGINE_ADDRESS=
VITE_HEDGE_VAULT_ADDRESS=
# Stock desk. Earn deposits of NVDA/SPCX/AAPL/GME/TSLA and stock-margin leverage.
# Leave blank until HedgeStockCollateral is deployed and the desk is funded.
VITE_HEDGE_STOCK_COLLATERAL=

# Reporter key. Pushes the Polymarket Yes price when someone opens or closes
# leverage, so the Railway keeper can stay off. Same key the keeper used.
# Never prefix with VITE_.
ORACLE_ADDRESS=0x19E7bd8d16b5D8dD1b619da5a791e6a04fFd3461
RELAYER_PRIVATE_KEY=

# Server only — never prefix with VITE_
PRIVY_APP_ID=
PRIVY_APP_SECRET=

RELAY_BRIDGE_API_KEY=

BUILDER_CODE_API_KEY=
BUILDER_CODE_SECRET_KEY=
BUILDER_CODE_PASSPHRASE=
POLYMARKET_BUILDER_CODE=

RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=

# Volume and nickname tracking. Optional: leaving these blank disables the
# analytics writes rather than breaking trading. The secret key bypasses row
# level security, so it must never be exposed to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Hedgie. Server-only — never prefix with VITE_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Agent Wall. Agents use their own wallets. Hedge never holds that key.
# The wall is free. Optional keys are labels on the public fill feed only.
AGENT_API_KEY=
AGENT_API_KEYS=
AGENT_MAX_MARGIN=25
AGENT_MAX_LEVERAGE=4
AGENT_DAILY_NOTIONAL=250
